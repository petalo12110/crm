# Render sets NODE_ENV=production as a service env var, and that same
# var is visible during the BUILD step too (not just runtime). Both npm
# and pnpm treat NODE_ENV=production as an implicit signal to skip
# devDependencies during install — but this project's build genuinely
# needs them (typescript, @types/*, vitest, etc. are all devDependencies
# required to compile). This setting forces devDependencies to install
# regardless of NODE_ENV. This is the real, permanent fix for both the
# earlier "prisma: command not found" issue and any "@types/* not found"
# type-check failures — moving individual packages to `dependencies` was
# a workaround; this is the actual root cause.
production=false
